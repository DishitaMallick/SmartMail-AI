{
  "name": "smartmail-ai",
  "version": "1.0.0",
  "description": "SmartMail AI - AI-Powered Gmail Organizer",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c magenta,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "./backend/venv/bin/uvicorn backend.main:app --reload --port 8000",
    "dev:frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev:backend",
    "frontend": "npm run dev:frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
